{
  "manifest_version": 3,
  "name": "CSM Case Dashboard",
  "version": "2.4.0",
  "description": "SAP CSM Team — ITSM + ONE360 Dashboard with AI Insight",

  "permissions": [
    "tabs",
    "cookies",
    "storage"
  ],

  "host_permissions": [
    "https://itsm.services.sap/*",
    "https://*.hana.ondemand.com/*",
    "https://one360.for.sap/*"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "action": {
    "default_title": "CSM Case Dashboard",
    "default_icon": {
      "16": "images/icon-16.png",
      "48": "images/icon-48.png",
      "128": "images/icon-128.png"
    },
    "default_popup": "popup.html"
  },

  "icons": {
    "16": "images/icon-16.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },

  "web_accessible_resources": [
    {
      "resources": ["korea-accounts.json"],
      "matches": ["<all_urls>"]
    }
  ],

  "browser_specific_settings": {
    "safari": {
      "strict_min_version": "15.0"
    }
  }
}
